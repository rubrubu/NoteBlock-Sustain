{
  "schemaVersion": 1,
  "id": "noteblocksustain",
  "version": "${version}",
  "name": "NoteBlock Sustain",
  "description": "Client-side Note Block sustain using the original Note Block Master sustained audio samples.",
  "authors": ["rubrubu", "Nayrus (original sustained audio assets)"],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.rubrubu.noteblocksustain.NoteBlockSustainMod"
    ],
    "client": [
      "com.rubrubu.noteblocksustain.NoteBlockSustainClient"
    ]
  },
  "mixins": [
    {
      "config": "noteblocksustain.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
